APP_ENV=development
APP_PORT=8080
APP_NAME=cross-site-tracker

SQLITE_PATH=./data/app.sqlite
MIGRATIONS_PATH=./migrations
SEED_DEFAULT_DATA=true

POLLING_ENABLED=true
POLLING_MINUTES=30
# How long a tracker that is not being read is left alone between polls.
POLLING_IDLE_MINUTES=720

# DEBUG|INFO|WARN|ERROR, any casing. Rejected requests (4xx) and the reasons a
# cover or chapter link was not resolved are only logged at DEBUG, so that is
# the setting to reach for when the dashboard is not showing what you expect.
LOG_LEVEL=INFO

# Where the process reads its templates and assets, and where it writes covers
# and uploaded site logos. The defaults match the container layout; set them
# only if you move those directories.
# WEB_DIR=./web
# DATA_DIR=./data
# DATA_DIR does NOT move the database. SQLITE_PATH above is independent.
